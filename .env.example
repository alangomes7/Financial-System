# ------------------------------------------------------------------
# Financial Management System - local development environment
#
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env            (Linux/macOS)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# NEVER commit `.env`. NEVER put production credentials in this file.
# The values below are placeholders for local development only.
# ------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose.yml) -----------------------
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change_me_local_only
# Host port published on 127.0.0.1. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Backend (Spring Boot) -----------------------------------------
# The backend reads this file automatically when started from `backend/`.
DB_URL=jdbc:postgresql://localhost:5432/finance_db
DB_USERNAME=finance_user
DB_PASSWORD=change_me_local_only
SERVER_PORT=8080
# Comma-separated list of browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) --------------------------------------------
# Next.js only reads env files from `frontend/`; copy this value into
# `frontend/.env.local` (see frontend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Reserved for later phases (leave empty for now) ---------------
# JWT_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# WHATSAPP_API_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

