# Normalize line endings in the repository; check out with native endings
# unless a file type requires a specific one.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
backend/mvnw text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.zip binary

